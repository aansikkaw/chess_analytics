+def _demo_pages(n_first, n_second):
+    games = parse_pgn(DEMO, "demo_player")
+    from app.library import to_pgn
+
+    texts = [to_pgn(g) for g in games]
+    return "\n\n".join(texts[:n_first]), "\n\n".join(texts[n_first:n_first + n_second])
+
