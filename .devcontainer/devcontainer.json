{
  "name": "chess_analytics",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y stockfish && pip install -r requirements-dev.txt && npx -y playwright install --with-deps chrome",
  "containerEnv": {
    "STOCKFISH_PATH": "/usr/games/stockfish"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Plateau Breaker",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "postStartCommand": "bash scripts/start_ollama.sh || true",
  "hostRequirements": {
    "memory": "8gb"
  }
}
