# ---------------------------------------------------------------------------------------
# Plateau Breaker production settings. Copy to deploy/.env and fill in. Never commit .env.
#
# Rules: comments go on their own lines (systemd doesn't allow them after a value), and any
# value containing $, spaces, # or quotes goes in single quotes, e.g. SMTP_PASSWORD='p$ss word'.
# ---------------------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------------------
# your domain; DNS A record must point at this server
DOMAIN=plateaubreaker.example
# used in email links (no trailing slash)
PUBLIC_URL=https://plateaubreaker.example
# cookies only over HTTPS (Caddy provides it)
COOKIE_SECURE=1
# these accounts get Pro + admin on signup
ADMIN_EMAILS=you@example.com
# shown in the app; support messages are sent here
SUPPORT_EMAIL=support@plateaubreaker.example
# sent to Lichess/Chess.com in the User-Agent
CONTACT_EMAIL=you@example.com

# --- Legal pages (/privacy, /terms, /refunds) ---------------------------------------------
# who runs the service, e.g. 'Your Name (sole proprietor)' or your company name
LEGAL_ENTITY=
# courts with jurisdiction in the terms
LEGAL_CITY=New Delhi
# set 1 after a lawyer has reviewed the pages (removes the "draft" note)
LEGAL_REVIEWED=0
# new accounts confirm 18+ and accept the terms (keep 1)
REQUIRE_TERMS=1
# INFO, or WARNING to log less
LOG_LEVEL=INFO

# --- Opponent Library and Twins ------------------------------------------------------------
# most games kept per library player by "Download full history" (about 6.5 KB each with the position index)
LIBRARY_FULL_MAX=10000
# games an Opponent Twin studies per build ("Keep learning" studies the next batch); about 1 s each
TWIN_GAMES=150
# engine depth for the Twin's candidates (when studying and when playing)
TWIN_DEPTH=9

# --- Engine and queue -------------------------------------------------------------------
ENGINE_DEPTH=12
ENGINE_TIME=0.08
# server-wide cap per sync
MAX_GAMES=500
# worker threads: about one per 2 CPU cores
MAX_CONCURRENT_IMPORTS=2
# games per turn before a long import yields
IMPORT_CHUNK=20
# set 1 once Chess.com approves commercial use
CHESSCOM_ENABLED=0

# --- AI coach: primary model, then a fallback if it fails or hits a limit --------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# A second provider (OpenRouter, Gemini, Together, Cerebras... any OpenAI-compatible API):
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=                     # if set, Claude becomes the primary model
# Rate limits. Groq's free tier allows ~30 requests a minute and a coach answer takes 2-5, so lower
# COACH_GLOBAL_PER_MINUTE to ~8 there; raise it on a paid plan.
# COACH_PER_MINUTE=6                    # per user
# COACH_GLOBAL_PER_MINUTE=30            # whole server; extra messages get the built-in coach
# API_REQUESTS_PER_MINUTE=300           # per IP, per web process

# --- Scoresheet photos (v1.1): which vision model reads them --------------------------
# Leave unset to use Claude (ANTHROPIC_API_KEY) or, with a Groq key above, Groq's vision model.
# VISION_BASE_URL=https://api.groq.com/openai/v1
# VISION_MODEL=qwen/qwen3.8-27b
# VISION_API_KEY=
# VISION_PROVIDER=off                    # turn photo reading off (typing still works)
# A second reader (v1.2), any OpenAI-compatible vision model; the two readings are merged by vote.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai (Google AI Studio key); OpenAI: https://api.openai.com/v1
# VISION2_BASE_URL=
# VISION2_MODEL=
# VISION2_API_KEY=

# --- Game report cards (v1.2) --------------------------------------------------------------
# REVIEW_DEPTH=14                        # Stockfish depth for report cards (12 on a small server)

# --- Email: verification, password reset, support, weekly digest ----------------------
# Test after any change: docker compose exec web python scripts/admin.py test-email you@example.com
#
# Option A, once you have a domain: Brevo's HTTPS API (free plan: 300 emails/day). Uses port 443,
# so it works even on hosts that block mail ports (several cloud hosts do for new accounts).
# Verify your domain in Brevo first: Gmail may silently drop mail "from" a gmail.com address sent via Brevo.
# BREVO_API_KEY=
#
# Option B: any SMTP server. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=your Gmail address,
# SMTP_PASSWORD=a 16-letter App Password (needs 2-Step Verification).
SMTP_HOST=
SMTP_PORT=587
# starttls for 587, ssl for 465; worked out from the port if left out
# SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# the address emails come from: a sender your provider has verified (for Gmail, your Gmail address)
EMAIL_FROM=hello@plateaubreaker.example
# 1 = unverified users can't sync or ask the coach
REQUIRE_EMAIL_VERIFICATION=0

# --- Backups (daily, to S3-compatible storage) -------------------------------------------
# e.g. s3://plateau-backups/daily
BACKUP_TARGET=
# e.g. https://<accountid>.r2.cloudflarestorage.com (empty for AWS)
S3_ENDPOINT_URL=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_KEEP=14
# a long passphrase; keep a copy somewhere safe
BACKUP_ENCRYPTION_KEY=
# 21:00 UTC = 02:30 IST
BACKUP_HOUR_UTC=21
# Mondays 03:00 UTC = 08:30 IST
DIGEST_HOUR_UTC=3

# --- Monitoring and analytics (optional) --------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# none | plausible | posthog
ANALYTICS=none
PLAUSIBLE_DOMAIN=plateaubreaker.example
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Prices shown on the Plans page (single quotes stop '$' being read as a variable) ------
PRO_PRICE_INR='₹399'
PRO_PRICE_USD='$6'
PRO_ANNUAL_INR='₹2,999'
PRO_ANNUAL_USD='$49'
EVENT_PRICE_INR='₹149'
EVENT_PRICE_USD='$3'
